<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Identity -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>M4 Group</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>m4_user</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- Device Requirements -->
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Supported Orientations (iPhone) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Supported Orientations (iPad) -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- Storyboard -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Performance -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Privacy Descriptions (required for App Store) -->
	<key>NSCameraUsageDescription</key>
	<string>M4 Group needs camera access to allow you to upload photos and documents.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>M4 Group needs photo library access to allow you to upload images.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>M4 Group needs permission to save images to your photo library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>M4 Group needs microphone access for audio features.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>M4 Group may use your location to provide location-based services.</string>

	<!-- Network Security (allow HTTPS) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>m4group.in</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- Deep Linking URL Scheme -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.m4group.user</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>m4group</string>
			</array>
		</dict>
	</dict>

	<!-- Associated Domains for Universal Links -->
	<!-- Note: Enable Associated Domains capability in Xcode and add applinks:m4group.in -->
</dict>
</plist>
